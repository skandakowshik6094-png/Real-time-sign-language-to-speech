# ── Python ────────────────────────────────────────────
__pycache__/
*.py[oc]
*.pyo
build/
dist/
wheels/
*.egg-info/
.eggs/

# ── Virtual environments ───────────────────────────────
.venv/
venv/
env/

# ── Node (package-lock / node_modules not needed) ─────
node_modules/

# ── ML artefacts (large — ship separately or via LFS) ─
checkpoints/*.pt
pretrained/
data/user/
data/autsl/
*.task

# Keep checkpoint directory stub
!checkpoints/.gitkeep
# Allow the small landmark classifier (~86 KB) — needed for Render deploy
!checkpoints/landmark_model.pt

# ── Logs ──────────────────────────────────────────────
logs/
src/logs/
*.log

# ── Training dataset (may be large; exclude raw data) ─
src/data/
# Allow landmark JSON dataset (~3 MB) — needed for re-training on Render
!data/landmarks/
!data/landmarks/landmark_dataset.json

